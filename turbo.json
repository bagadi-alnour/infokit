{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_MIGRATOR",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "AUTH_EMAIL_FROM",
    "BOOTSTRAP_SUPERADMIN_EMAIL",
    "AWS_PROFILE",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_MESSAGING_ACCESS_KEY_ID",
    "AWS_MESSAGING_SECRET_ACCESS_KEY",
    "AWS_MESSAGING_REGION",
    "AWS_S3_ASSET_BUCKET",
    "AWS_S3_ENDPOINT",
    "AWS_S3_FORCE_PATH_STYLE",
    "AWS_SNS_SENDER_ID",
    "OPENAI_API_KEY",
    "OPEN_AI_API_KEY",
    "AI_TRANSLATION_PROVIDER",
    "AI_TRANSLATION_MODEL",
    "SITE_URL",
    "AUTH_DEV_LOG_DELIVERY",
    "ENABLE_PHASE3_MEMBER_ASSIGNMENTS",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "db:names": {}
  }
}
