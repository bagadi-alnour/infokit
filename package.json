{
  "name": "infokit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck",
    "check:ci": "pnpm format:check && turbo run lint typecheck",
    "db:generate": "pnpm --filter @infokit/web db:generate",
    "db:migrate": "pnpm --filter @infokit/web db:migrate",
    "db:push": "pnpm --filter @infokit/web db:push",
    "db:studio": "pnpm --filter @infokit/web db:studio",
    "android": "pnpm --filter @infokit/mobile android",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "pnpm --filter @infokit/web dev",
    "dev:mobile": "pnpm --filter @infokit/mobile dev",
    "dev:mobile:tunnel": "pnpm --filter @infokit/mobile dev:tunnel",
    "dev:web": "pnpm --filter @infokit/web dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,json,md,css}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,json,md,css}\" --cache",
    "ios": "pnpm --filter @infokit/mobile ios",
    "lint": "turbo run lint",
    "prepare": "simple-git-hooks",
    "start": "pnpm --filter @infokit/web start",
    "test:unit": "pnpm --filter @infokit/web test:unit",
    "typecheck": "turbo run typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{json,md,mdx,css}": [
      "prettier --write --cache"
    ]
  },
  "devDependencies": {
    "lint-staged": "^17.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.1"
}
