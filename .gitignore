# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo: patterns are unrooted so they apply in every workspace package.

# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file.
# match every .env variant, including suffixed copies like .env.prod.local.bak
.env*
!.env.example
!.env*.example

# belt and braces: editor/manual copies of a secret file keep their payload but
# lose the extension the rules above key on (.env.prod.local.bak got staged once)
*.bak
*.orig
*~

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# tool caches
.cache/
.turbo/
