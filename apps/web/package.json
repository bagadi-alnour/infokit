{
  "name": "@infokit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:drift": "tsx scripts/schema-drift.ts",
    "db:drift:remote": "DOTENV_CONFIG_PATH=${ENV_FILE:?set ENV_FILE to the env file holding the remote DATABASE_URL_MIGRATOR, e.g. ENV_FILE=.env.prod.local} tsx scripts/schema-drift.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "DOTENV_CONFIG_PATH=${ENV_FILE:?set ENV_FILE to the env file holding the remote DATABASE_URL_MIGRATOR, e.g. ENV_FILE=.env.prod.local} drizzle-kit migrate",
    "db:names": "tsx scripts/schema-identifiers.ts",
    "db:push": "tsx scripts/db-push-guard.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:remote": "DOTENV_CONFIG_PATH=${ENV_FILE:?set ENV_FILE to the env file holding the remote DATABASE_URL_MIGRATOR, e.g. ENV_FILE=.env.prod.local} tsx src/server/db/seed.ts",
    "db:seed:demo": "tsx src/server/db/seed-demo-content.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo --port 3030",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "preview": "next build && next start --port 3030",
    "start": "next start --port 3030",
    "test:unit": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --cache --cache-location .cache/eslint",
      "prettier --write --cache"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.18",
    "@auth/drizzle-adapter": "^1.7.2",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1090.0",
    "@aws-sdk/client-sns": "^3.1090.0",
    "@aws-sdk/credential-providers": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@infokit/shared": "workspace:*",
    "@infokit/tokens": "workspace:*",
    "@infokit/validation": "workspace:*",
    "@inkpilot/editor": "0.1.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.83.0",
    "react-native-web": "0.21.2",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.13.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
