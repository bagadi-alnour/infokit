# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Required because Auth.js derives callback URLs from the host header. Only set
# this when the deployment proxy rejects unrecognized hosts.
AUTH_TRUST_HOST="true"

# The same AWS profile sends SES email and SNS SMS. The ep profile is the
# project default; eu-west-3 is the verified sending region.
AWS_PROFILE="ep"
AWS_REGION="eu-west-3"

# Public origin used for canonical URLs, Open Graph metadata, robots.txt, and
# sitemap.xml. Do not include a trailing path.
SITE_URL="http://localhost:3030"

# SES-verified sender. A display name is allowed.
AUTH_EMAIL_FROM="Calais Info <login@example.org>"

# Comma-separated email=phone pairs. These are the only editor identities
# allowed to sign in; phone numbers must use E.164 format.
EDITOR_MFA_RECIPIENTS="editor@example.org=+12025550123"

# Optional alphanumeric sender ID, where the destination country supports it.
# AWS_SNS_SENDER_ID="CalaisInfo"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5433/calais-info"

# Dev/test only: log magic links + SMS codes to the server console instead of AWS.
AUTH_DEV_LOG_DELIVERY="false"
