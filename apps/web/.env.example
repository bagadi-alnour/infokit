# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Required because Auth.js derives callback URLs from the host header. Only set
# this when the deployment proxy rejects unrecognized hosts.
AUTH_TRUST_HOST="true"

# The same credentials send SES email and SNS SMS; eu-west-3 is the verified
# sending region. Leave AWS_PROFILE unset to use the standard credential chain
# (default profile locally, environment keys or task role in production). Set it
# only to pin a named profile, and only one that exists in ~/.aws/credentials —
# an unknown profile fails every send at credential resolution.
# AWS_PROFILE="ep"
#
# On Vercel there is no ~/.aws and no task role, so AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY have to be set explicitly — and so does AWS_REGION, which
# Vercel presets from the deployment region. A project deployed in iad1 arrives as
# us-east-1, which silently beats the eu-west-3 default in src/env.js and then
# fails every send: the SES identity is verified in eu-west-3 only.
AWS_REGION="eu-west-3"

# Optional second identity, used by SES and SNS only, for when email and SMS have
# to leave from a different AWS account than the one holding the asset bucket.
# Leaving a sending sandbox is granted per account and is NOT inherited from an
# AWS Organization, so a fresh account can own the database and the bucket while
# an older, already-approved account still does the sending. Both must be set to
# take effect; unset means messaging shares the keys above, which is how such an
# arrangement ends — delete the two variables and deploy no code. Point them at a
# send-only IAM user: a general-purpose one puts every bucket and table in the
# other account inside this app's blast radius.
# AWS_MESSAGING_ACCESS_KEY_ID=""
# AWS_MESSAGING_SECRET_ACCESS_KEY=""
# Defaults to AWS_REGION. Set it only when the sending account sends from
# somewhere else — a verified identity and a sender ID are both regional.
# AWS_MESSAGING_REGION="eu-west-3"

# Private S3-compatible bucket for article images and other source assets.
# Objects remain private; the application issues short-lived signed requests.
AWS_S3_ASSET_BUCKET="infokit-assets"
# Leave unset for AWS S3. Set only for a compatible service such as MinIO.
# AWS_S3_ENDPOINT="https://s3.example.org"
AWS_S3_FORCE_PATH_STYLE="false"

# Server-only AI translation proposals. Generated content remains unpublished
# and requires human review. OPEN_AI_API_KEY is accepted as a legacy alias.
# OPENAI_API_KEY=""
AI_TRANSLATION_PROVIDER="openai"
AI_TRANSLATION_MODEL="gpt-5.6-terra"

# Public origin used for canonical URLs, Open Graph metadata, robots.txt, and
# sitemap.xml. Do not include a trailing path.
SITE_URL="http://localhost:3030"

# SES-verified sender. A display name is allowed.
AUTH_EMAIL_FROM="InfoKit <login@example.org>"

# Seed-only bootstrap: the first account allowed to sign in, granted the
# platform's technical roles. Created if it does not exist yet. Everyone else
# arrives through an invitation this account sends, and every account — this one
# included — enrols its own phone number for the SMS step-up on first sign-in.
# Pass the password only when an initial password must be set; omit it on
# routine seeds. The seed guards on the variable's presence, so omitting it
# creates the account with no password hash at all — which is how production is
# set up deliberately: nobody's production password sits in a file, the first
# password is chosen through /<locale>/login/reset, and an account with no hash
# can be given one but never signed into without one.
BOOTSTRAP_SUPERADMIN_EMAIL="editor@example.org"
# BOOTSTRAP_SUPERADMIN_PASSWORD="use-a-secret-with-at-least-12-characters"

# Optional alphanumeric sender ID, where the destination country supports it.
# Must contain at least one letter (a numeric-only sender ID is rejected), max 11
# characters, and no dash for France. France accepts unregistered — "dynamic" —
# sender IDs, so no approval is needed there; countries like the UK and Ireland do
# require registration, and an unregistered ID there is delivered as "NOTICE" or
# rewritten to "Likely Scam".
#
# Unset does not mean "send from a number". SNS falls back to the account-level
# DefaultSenderID (`aws sns get-sms-attributes`), and only if that is also unset
# does it use a dedicated number owned in the destination country — which for
# France cannot exist, because France does not support long codes.
# Uppercase, because carriers treat the value as case-sensitive.
# AWS_SNS_SENDER_ID="INFOKIT"

# Drizzle — two identities, deliberately, in local too.
#
# A table's owner bypasses row-level security, so if local DATABASE_URL stayed
# `postgres`, every policy would do nothing on the machine it was written on and
# everything in production. That is the one environment split worth paying to
# avoid. See src/server/db/migrator-url.ts.
#
# The application: `infokit_app`. Owns nothing, holds no UPDATE or DELETE on the
# eight append-only tables. The role is created by drizzle/0002_roles.sql without
# a password — a password in a migration file is a password in git — so set it by
# hand once per environment, to whatever you write here:
#   docker exec infokit-postgres psql -U postgres -d infokit \
#     -c "ALTER ROLE infokit_app PASSWORD 'localdev'"
DATABASE_URL="postgresql://infokit_app:localdev@localhost:5433/infokit"
# The owner. Only db:migrate, db:studio, db:seed, db:drift and db:names use it;
# the running app never does, and a deployment that omits it can still serve — it
# just cannot migrate itself, which is the correct division. start-database.sh
# reads the container's postgres password from here.
#
# To point any of them at a remote database, use the `:remote` variant —
# db:migrate:remote, db:seed:remote, db:drift:remote — with ENV_FILE naming the
# file that holds the remote URL. Only those three map ENV_FILE to
# DOTENV_CONFIG_PATH, so `ENV_FILE=… pnpm db:seed` reads this file instead and
# seeds local Docker while reporting success.
DATABASE_URL_MIGRATOR="postgresql://postgres:password@localhost:5433/infokit"
#
# Keep both of these pointed at local Docker, permanently. Remote URLs live in
# .env.prod.local (gitignored), which nothing loads by accident: Next only
# auto-loads .env.$NODE_ENV.local and NODE_ENV is never `prod`. TLS is not
# configured here and does not need to be — src/server/db/ssl.ts connects in the
# clear to localhost only and demands verify-full against the RDS certificate
# bundle for every other host, so an sslmode appended to a URL cannot weaken it.

# Dev/test only: log magic links + SMS codes to the server console instead of AWS.
AUTH_DEV_LOG_DELIVERY="false"

# Phase 3 gate. Leave false until the legal/operator gate is approved. Before
# that gate, use true only in local development with labelled fictional data.
ENABLE_PHASE3_MEMBER_ASSIGNMENTS="false"

# Optional, db:seed:demo only: the image every demo cover points at. A picture
# has to be uploaded through the console — the seed cannot invent an object in
# storage — so by default it takes the newest image the console holds, and
# seeds without covers when there is none. Set this to pin a particular one.
# DEMO_COVER_ASSET_ID="00000000-0000-0000-0000-000000000000"

# Not listed above and never to be set: SEED_DEMO_FORCE. It is the escape hatch
# on the local-host check in src/server/db/seed-demo-content.ts, and demo content
# in a real environment is AGENTS.md hard rule 5. It belongs in no environment,
# and least of all in a deployment's variables.
