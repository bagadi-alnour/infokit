{
  "name": "@infokit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "node scripts/dev.mjs --android",
    "bundle": "expo export --platform ios --output-dir .expo/export",
    "dev": "node scripts/dev.mjs",
    "dev:tunnel": "node scripts/dev.mjs --tunnel",
    "ios": "node scripts/dev.mjs --ios",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint",
    "start": "expo start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-strategy content --cache-location .cache/eslint",
      "prettier --write --cache"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@infokit/api-client": "workspace:*",
    "@infokit/shared": "workspace:*",
    "@infokit/tokens": "workspace:*",
    "@infokit/ui": "workspace:*",
    "better-auth": "^1.6.25",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "eslint": "^9.23.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}
