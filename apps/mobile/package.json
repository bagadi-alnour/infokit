{
  "name": "@infokit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "bundle": "expo export --platform ios --output-dir .expo/export",
    "dev": "expo start",
    "ios": "expo start --ios",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "start": "expo start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-location .cache/eslint",
      "prettier --write --cache"
    ]
  },
  "dependencies": {
    "@infokit/shared": "workspace:*",
    "@infokit/tokens": "workspace:*",
    "@infokit/ui": "workspace:*",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.7",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "^19.1.1",
    "eslint": "^9.23.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}
