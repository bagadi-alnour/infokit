{
  "expo": {
    "name": "InfoKit",
    "slug": "infokit",
    "version": "0.1.0",
    "scheme": "infokit",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "org.infokit.app",
      "supportsTablet": true
    },
    "android": {
      "package": "org.infokit.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
