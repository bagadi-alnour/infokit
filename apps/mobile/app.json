{
  "expo": {
    "name": "InfoKit",
    "slug": "infokit",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "infokit",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "org.infokit.app",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.infokit.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60524326-195e-47e1-bccb-b712768475fb"
      }
    },
    "owner": "bgaato"
  }
}
