# Where the app reads published information. Point it at the web app of the
# environment this build belongs to; without it, a dev build uses the local
# Next server (http://localhost:3030, or http://10.0.2.2:3030 on Android).
EXPO_PUBLIC_INFOKIT_API_URL=http://localhost:3030

# The welcome flow replays on every launch of a dev build so it can be worked
# on. Set this to `once` to get the real behaviour — shown on first run only.
# EXPO_PUBLIC_INFOKIT_WELCOME=once
