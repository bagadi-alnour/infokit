{
  "name": "@calais/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-location .cache/eslint",
      "prettier --write --cache"
    ]
  },
  "dependencies": {
    "@calais/tokens": "workspace:*",
    "@calais/validation": "workspace:*",
    "@tamagui/config": "2.4.6",
    "tamagui": "2.4.6"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}
